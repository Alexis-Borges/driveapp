# Clé service_role du projet Supabase de DEV.
# Dashboard Supabase > Project Settings > API > "service_role secret".
#
# Cette clé bypass la RLS — utilisée uniquement par les scripts scripts/*.mjs
# (seed-dev, simulate-activity). Ne JAMAIS la commiter ni l'utiliser sur le
# projet de production.
#
# Copier ce fichier vers .env.seed puis remplacer la valeur.
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Optionnel : mot de passe commun des comptes de dev (défaut : DriveDev2026!)
# SEED_PASSWORD=DriveDev2026!
